#!/usr/bin/env bash
set -eo pipefail

normalize_cookbook() {
  local raw=$1
  
  # Check exact paths first
  if [[ -f "$raw" ]]; then
    echo "$raw"
  elif [[ -f "${raw}.rb" ]]; then
    echo "${raw}.rb"
  elif [[ -f "cookbooks/${raw}/default.rb" ]]; then
    echo "cookbooks/${raw}/default.rb"
  elif [[ -f "roles/${raw}/default.rb" ]]; then
    echo "roles/${raw}/default.rb"
  else
    echo "Error: Could not find cookbook for '${raw}'" >&2
    exit 1
  fi
}

# Main execution
if [[ $# -eq 0 ]]; then
  echo "Error: No cookbooks specified" >&2
  exit 1
fi

for arg in "$@"; do
  normalize_cookbook "$arg"
done
