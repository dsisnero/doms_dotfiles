#!/bin/bash
set -eu

usage() {
  echo "Usage: $0 [--debug] [--role ROLE] [--host HOSTNAME] [cookbook1 cookbook2...]"
  echo "  --debug   Enable debug logging"
  echo "  --role    Set deployment role (development, media, minimal, home-assistant)"
  echo "  --host    Set system hostname (e.g., pi-dev, pi-media)"
  echo "  cookbooks Space-separated list of cookbooks to deploy"
  echo ""
  echo "Examples:"
  echo "  Deploy everything       : ./bin/deploy"
  echo "  Deploy git cookbook     : ./bin/deploy git"
  echo "  Debug mode deployment   : ./bin/deploy --debug"
  echo "  Debug specific cookbook : ./bin/deploy --debug dotfiles"
  echo "  Deploy with role        : ./bin/deploy --role development"
  echo "  Set hostname and role   : ./bin/deploy --role development --host pi-dev"
  exit 1
}

# Parse arguments
DEBUG=false
ROLE=""
HOSTNAME=""
COOKBOOKS=()
while [[ $# -gt 0 ]]; do
  case $1 in
    --debug)
      DEBUG=true
      shift
      ;;
    --role)
      if [[ -z $2 ]]; then
        echo "Error: --role requires a value"
        usage
      fi
      ROLE="$2"
      shift 2
      ;;
    --host)
      if [[ -z $2 ]]; then
        echo "Error: --host requires a value"
        usage
      fi
      HOSTNAME="$2"
      shift 2
      ;;
    *)
      COOKBOOKS+=("$1")
      shift
      ;;
  esac
done
export ROLE
export HOSTNAME

./bin/setup

run_mitamae() {
  local level=$1
  local recipe=$2
  # Load github_binary plugin by setting RUBYLIB
  cmd="RUBYLIB=./plugins/mitamae-plugin-resource-github_binary/mrblib:\${RUBYLIB:-} bin/mitamae local --shell /bin/bash -l $level $recipe"
  case "$(uname)" in
    "Darwin") RUBYLIB=./plugins/mitamae-plugin-resource-github_binary/mrblib:${RUBYLIB:-} bin/mitamae local -l $level $recipe ;;
    *) sudo -E bash -c "cd $(pwd) && ZSH_DISABLE_COMPFIX=true SHELL=/bin/bash NO_RCS=true SSH_AUTH_SOCK=${HOME}/.ssh/agent.sock $cmd" ;;
  esac
}

if [ ${#COOKBOOKS[@]} -eq 0 ]; then
  # Full deployment
  level="info"
  $DEBUG && level="debug"
  run_mitamae $level "lib/recipe.rb"
else
  # Individual cookbooks
  level="info"
  $DEBUG && level="debug"
  normalized=($(./bin/normalize_cookbooks "${COOKBOOKS[@]}"))
  run_mitamae $level "lib/recipe_helper.rb ${normalized[@]}"
fi
