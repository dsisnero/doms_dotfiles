#!/bin/bash

set -eu

## setup mitamae
# Detect architecture
ARCH=$(uname -m)
case "$ARCH" in
  x86_64|amd64)
    ARCH_SUFFIX="x86_64"
    ;;
  aarch64|arm64)
    ARCH_SUFFIX="aarch64"
    ;;
  armv7l|armhf)
    ARCH_SUFFIX="armhf"
    ;;
  i686|i386)
    ARCH_SUFFIX="i686"
    ;;
  *)
    echo "Unsupported architecture: $ARCH"
    exit 1
    ;;
esac

# Check for Linux container environment first (e.g., when running in container on macOS)
if [ -f /etc/os-release ]; then
  OS='Linux'
  MITAMAE_URL="https://github.com/itamae-kitchen/mitamae/releases/download/v1.12.7/mitamae-${ARCH_SUFFIX}-linux"
  if grep 'Arch Linux' /etc/os-release>/dev/null; then
    which unzip >/dev/null 2>&1 || sudo pacman -S --noconfirm unzip
  elif grep 'Ubuntu' /etc/os-release>/dev/null; then
    which unzip >/dev/null 2>&1 || sudo apt install -y unzip
  fi
elif [ "$(uname)" == 'Darwin' ]; then
  OS='Mac'
  MITAMAE_URL="https://github.com/itamae-kitchen/mitamae/releases/download/v1.12.7/mitamae-${ARCH_SUFFIX}-darwin"
elif [ "$(expr substr $(uname -s) 1 5)" == 'Linux' ]; then
  OS='Linux'
  MITAMAE_URL="https://github.com/itamae-kitchen/mitamae/releases/download/v1.12.7/mitamae-${ARCH_SUFFIX}-linux"
elif [ "$(expr substr $(uname -s) 1 10)" == 'MINGW32_NT' ]; then
  OS='Cygwin'
  echo "Your platform ($(uname -a)) is not supported."
  exit 1
else
  echo "Your platform ($(uname -a)) is not supported."
  exit 1
fi

if [ ! -e bin ]; then
  mkdir -p bin
fi

if [ ! -e bin/mitamae ]; then
  curl -s -L ${MITAMAE_URL} -o bin/mitamae
  chmod +x bin/mitamae
fi
