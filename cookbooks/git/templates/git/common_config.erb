[init]
	defaultBranch = main

[core]
	attributesfile = <%= File.join(@config_dir, ".gitattributes_global") %>
	excludesfile   = <%= File.join(@config_dir, ".gitignore_global") %>
	autocrlf = input
	quotepath = false
	precomposeunicode = true
	commentChar = ";"
	pager = delta

