#!/bin/sh
#
# Sweep AppleDouble (._*) sidecars from the WORKING TREE on exFAT volumes.
#
# Why this exists: macOS sets a `com.apple.provenance` xattr on files that git
# writes. exFAT cannot store xattrs, so macOS writes a `._<name>` sidecar next
# to each one instead. This is unavoidable (verified: COPYFILE_DISABLE=1 and
# `xattr -cr` both have no effect, and there is no git config for it) and a
# fresh 1-file repo produces ~44 sidecars after a single commit.
#
# Why it matters: this exFAT volume has a 128 KB allocation block, so every
# sidecar costs a full 128 KB. 2.1M of them is ~264 GB of dead space.
#
# The previous version of this hook only swept .git/ (3 files in alef, all
# harmless) and never the worktree, and its counter deleted before counting so
# it always reported "clean". It is preserved as cleanup-appledouble.bak.*.
#
# Wired as post-checkout and post-merge. Deliberately NOT a pre-commit hook:
# `._*` is already in .gitignore, so these can never be staged.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# Fast pre-filter: repos on the internal APFS volume never produce sidecars, so
# don't pay for a diskutil call on every checkout there.
case "$root" in
    /Volumes/*) ;;
    *) exit 0 ;;
esac

# Confirm it's actually exFAT before touching anything.
#
# NOTE: `diskutil info` only accepts a mounted volume or device -- given a
# subdirectory it fails with "Could not find disk". The previous version of this
# hook passed $repo_dir (a subdirectory) straight to diskutil, so its exFAT
# check could never succeed and the cleanup never ran. That was the real reason
# ~264 GB of sidecars accumulated, not the missing worktree sweep alone.
vol=$(printf '%s' "$root" | sed -n 's,^\(/Volumes/[^/]*\).*,\1,p')
[ -n "$vol" ] || exit 0

case "$(diskutil info "$vol" 2>/dev/null | grep -i 'File System Personality')" in
    *xFAT* | *Xfat* | *XFAT*) ;;
    *) exit 0 ;;
esac

# Sweep the working tree. The constraints are load-bearing:
#   -type f        `._*` also matches DIRECTORIES; -delete cannot remove one.
#   -not target/   build output is disposable and huge; cargo regenerates it.
#   timeout        a hook must never be able to hang a checkout.
#   exit 0         a non-zero exit here makes `git checkout` report failure.
timeout 30 find "$root" -type f -name '._*' \
    -not -path '*/target/*' -not -path '*/.git/*' -delete 2>/dev/null

# .git itself, separately and last, so the two scopes can't interfere. Safe at
# post-checkout/post-merge (quiescent points).
timeout 15 find "$root/.git" -type f \
    \( -name '._*' -o -name '.DS_Store' \) -delete 2>/dev/null

# AppleDouble entries for directories are directories themselves, so they need
# their own pass once the inner file is gone.
timeout 15 find "$root" -depth -type d -name '._*' -empty \
    -not -path '*/target/*' -delete 2>/dev/null

exit 0
