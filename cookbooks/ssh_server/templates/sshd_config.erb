# SSH server configuration managed by MItamae.
# Strategy (aligned with upstream OpenSSH sshd_config):
# - Keep OpenSSH defaults unless there is a clear policy decision.
# - Explicitly set only the knobs this cookbook owns.
#
# Reference:
# - OpenSSH portable default sshd_config (master branch)
# - sshd_config(5): https://man.openbsd.org/sshd_config

# Network listener port.
Port <%= @port %>
# Bind to specific addresses only if needed.
# ListenAddress 0.0.0.0
# ListenAddress ::

# Host keys:
# Keep defaults to avoid platform-specific paths (Linux/macOS/Windows differ).
# HostKey ...

# Crypto policy:
# Avoid hard-coding KEX/Ciphers/MACs unless your compliance baseline requires it.
# OpenSSH defaults are actively maintained and safer over time than static lists.
# KexAlgorithms ...
# Ciphers ...
# MACs ...

# Logging verbosity and facility.
SyslogFacility AUTH
LogLevel INFO

# Auth hardening and session limits.
# Time allowed to authenticate before disconnect.
LoginGraceTime 120
# Root login policy (e.g. prohibit-password / no / yes).
PermitRootLogin <%= @permit_root_login %>
# Enforce strict ownership/permissions checks for user files.
StrictModes yes
# Failed auth attempts per connection before disconnect.
MaxAuthTries <%= @max_auth_tries %>
# Concurrent sessions per network connection.
MaxSessions <%= @max_sessions %>

# User allow-list. Keep this tight in single-user/workstation setups.
<% if @allow_users %>
AllowUsers <%= @allow_users %>
<% end %>
# AllowGroups sshusers
# DenyUsers root
# DenyGroups root

# Public key auth should usually stay enabled.
PubkeyAuthentication <%= @pubkey_authentication %>
# Password auth for compatibility; set to "no" for key-only auth.
PasswordAuthentication <%= @password_authentication %>
# Never allow empty passwords.
PermitEmptyPasswords <%= @permit_empty_passwords %>
# Keyboard-interactive auth (ChallengeResponseAuthentication is deprecated alias).
KbdInteractiveAuthentication <%= @challenge_response_authentication %>

# Optional enterprise auth systems (disabled by default).
# KerberosAuthentication no
# GSSAPIAuthentication no

<% if node[:platform] != 'darwin' && node[:platform] != 'osx' && node[:platform] != 'windows' %>
# PAM integration for Linux/Unix systems.
UsePAM <%= @use_pam %>
<% end %>

# Forwarding features. Tighten these if you do not need tunnels/agent forwarding.
AllowAgentForwarding yes
AllowTcpForwarding yes
# GatewayPorts no
X11Forwarding <%= @x11_forwarding %>
X11DisplayOffset 10
X11UseLocalhost yes

# Session behavior.
# PermitTTY yes
PrintMotd no
PrintLastLog yes
TCPKeepAlive yes
# Idle timeout controls: disconnect inactive sessions.
ClientAliveInterval <%= @client_alive_interval %>
ClientAliveCountMax <%= @client_alive_count_max %>

# DNS reverse lookup; disabling speeds up some login paths.
UseDNS no

# Connection flood control.
# MaxStartups 10:30:100
# PermitTunnel no
# ChrootDirectory none
# VersionAddendum none
# Banner none

<% if node[:platform] != 'darwin' && node[:platform] != 'osx' && node[:platform] != 'windows' %>
# Locale environment passthrough for interactive shells.
AcceptEnv LANG LC_*
<% end %>

# Use built-in SFTP subsystem for maximum portability.
Subsystem sftp internal-sftp

# Example of per-user override:
# Match User anoncvs
#   X11Forwarding no
#   AllowTcpForwarding no
#   PermitTTY no
#   ForceCommand cvs server
