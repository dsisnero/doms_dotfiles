# vim: set ft=zsh:

if [[ -z "${PIP_SITE_LOCATION}" ]]; then
  export PIP_SITE_LOCATION=$(mise exec -- pip show -f powerline-status | grep Location | awk '{print $2}')
  echo "Please set env: export PIP_SITE_LOCATION=$PIP_SITE_LOCATION"
fi

source <%= node[:doms_dotfiles] %>/config/.zshrc
<% if node[:platform] == 'osx' or node[:platform] == 'darwin' -%>
source <%= node[:doms_dotfiles] %>/config/zsh/.zshrc_osx

# macOS-only ollama launchctl aliases
alias ollama_start='launchctl load ~/Library/LaunchAgents/com.ollama.serve.plist'
alias ollama_stop='launchctl unload ~/Library/LaunchAgents/com.ollama.serve.plist'
<% else -%>
source <%= node[:doms_dotfiles] %>/config/zsh/.zshrc_unix
  <%- if node[:is_wsl] -%>
source <%= node[:doms_dotfiles] %>/config/zsh/.zshrc_wsl
  <%- end -%>
<% end -%>

# Use local neofetch if available
if [[ -f <%= node[:repos] %>/github.com/dylanaraps/neofetch/neofetch ]]; then
  alias neofetch='<%= node[:repos] %>/github.com/dylanaraps/neofetch/neofetch'
fi

# Load utility scripts
utils_dir=<%= node[:doms_dotfiles] %>/config/zsh/zsh-utils
source <%= node[:doms_dotfiles] %>/config/zsh/zsh-utils/scripts/functions.zsh
source_scripts_in_tree $utils_dir

<%- if node[:is_wsl] -%>
alias explorer='/mnt/c/Windows/explorer.exe'
<%- end -%>

# Define peco_history function for command history completion
peco_history() {
  local history_cmd
  if [ -n "$FILTER_CMD" ]; then
    # Use platform-appropriate reverse command
    if command -v tac >/dev/null 2>&1; then
      history_cmd="history -n 1 | tac | $FILTER_CMD"
    else
      history_cmd="history -n 1 | tail -r | $FILTER_CMD"
    fi
    eval "$history_cmd"
  else
    echo "Error: FILTER_CMD is not set. Install peco or fzf."
  fi
}

# profiling
if (which zprof > /dev/null 2>&1) ;then
  # zprof
fi

alias dprint="dprint --config \"<%= node[:config_home] %>/dprint/config.json\""
