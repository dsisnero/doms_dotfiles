[credential]
  helper = manager
  credentialStore = gpg

[ghq]
user = dsisnero
root = d:/repos

<!-- [core] -->
  <!-- symlinks = false -->
  <!-- protectNTFS = true -->

[difftool "vscode"]
  cmd = code --wait --diff $LOCAL $REMOTE # VS Code diff command

[difftool "vsdiffmerge"]
  cmd = \"C:/Program Files (x86)/Microsoft Visual Studio/2019/Professional/Common7/IDE/CommonExtensions/Microsoft/TeamFoundation/Team Explorer/VsDiffMerge.exe\" \"$LOCAL\" \"$REMOTE\" //t

[mergetool "vscode"]
  cmd = code --wait $MERGED # VS Code merge resolution

[mergetool "vsdiffmerge"]
  cmd = \"C:/Program Files (x86)/Microsoft Visual Studio/2019/Professional/Common7/IDE/CommonExtensions/Microsoft/TeamFoundation/Team Explorer/VsDiffMerge.exe\" \"$LOCAL\" \"$REMOTE\" \"$BASE\" \"$MERGED\" //m
