<%# COMMON SETTINGS (all platforms) %>
[core]
  pager = delta
  autocrlf = <%= ['windows', 'wsl'].include?(@platform) ? 'true' : 'input' %>

[diff]
  colorMoved = default
  algorithm = histogram

[merge]
  conflictstyle = diff3
  ff = false

<%# PLATFORM-SPECIFIC OVERRIDES %>
<% case @platform %>
<% when 'darwin' %>
[credential]
  helper = osxkeychain
  credentialStore = gpg

[difftool]
  prompt = false

[merge]
  tool = opendiff

<% when 'arch', 'ubuntu' %>
[credential]
  helper = cache --timeout=3600
  <% if @is_wsl %>
  helper = /usr/local/bin/git-credential-manager
  <% end %>

[difftool "nvimdiff"]
  cmd = "nvim -R -d -c \"wincmd l\" -d \"$LOCAL\" \"$REMOTE\""

[merge]
  tool = nvimdiff

[mergetool]
  prompt = true

[mergetool "nvimdiff"]
  cmd = "nvim -d -c \"4wincmd w | wincmd J\" \"$LOCAL\" \"$BASE\" \"$REMOTE\"  \"$MERGED\""

<% when 'windows' %>
[credential]
  helper = manager
  credentialStore = gpg

[core]
  symlinks = false
  protectNTFS = true

[difftool "vsdiffmerge"]
  cmd = \"C:/Program Files (x86)/Microsoft Visual Studio/2019/Professional/Common7/IDE/CommonExtensions/Microsoft/TeamFoundation/Team Explorer/VsDiffMerge.exe\" \"$LOCAL\" \"$REMOTE\" //t

[mergetool "vsdiffmerge"]
  cmd = \"C:/Program Files (x86)/Microsoft Visual Studio/2019/Professional/Common7/IDE/CommonExtensions/Microsoft/TeamFoundation/Team Explorer/VsDiffMerge.exe\" \"$LOCAL\" \"$REMOTE\" \"$BASE\" \"$MERGED\" //m
<% end %>

<%# WSL-SPECIFIC OVERRIDES %>
<% if @is_wsl && @platform != 'windows' %>
[credential "https://dev.azure.com"]
  useHttpPath = true

[credential "https://github.com"]
  helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
  helper = !/usr/bin/gh auth git-credential
<% end %>
