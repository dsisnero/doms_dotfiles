[init]
	templatedir = ~/repos/github.com/dsisnero/doms_dotfiles/config/git/templates
	defaultBranch = main

[core]
	attributesfile = ~/repos/github.com/dsisnero/doms_dotfiles/config/git/.gitattributes_global
	excludesfile   = ~/repos/github.com/dsisnero/doms_dotfiles/config/git/.gitignore_global
	autocrlf = input
	quotepath = false
	precomposeunicode = true
	commentChar = ";"
	pager = delta

[ghq]
	user = dsisnero
	root = ~/repos

[github]
	user = dsisnero

[user "ssh://git@gitlab.com/"]
	name = Dominic Sisneros
	email = dsisnero@gmail.com
[user "https://gitlab.com/"]
	name = Dominic Sisneros
	email = dsisnero@gmail.com
[user "http://gitlab.com/"]
	name = Dominic Sisneros
	email = dsisnero@gmail.com
[user "ssh://git@github.com/"]
	name = Dominic Sisneros
	email = dsisnero@gmail.com
[user "https://github.com/"]
	name = Dominic Sisneros
	email = dsisnero@gmail.com
[user "http://github.com/"]
	name = Dominic Sisneros
	email = dsisnero@gmail.com

[color]
	status = auto
	diff = auto
	branch = auto
	interactive = auto
	grep = auto
	ui = auto

[alias]
	# Cross-platform core commands
	ps = push
	pl = pull
	ft = fetch
	ad = add
	co = checkout
	st = status --short --branch  # Compact status view
	sh = show
	sw = switch                   # Modern branch switching
	cm = commit
	df = diff
	lg = log
	gr = grep
	tg = tag
	br = branch

	# Branch management
	bra = branch -a               # List all branches
	
	# Log visualization
	wc = whatchanged              # Show what changed in commits
	ls = log --stat               # Log with file stats
	lp = log -p                   # Log with patches
	la = log --pretty=\"format:%ad %h (%an): %s\" --date=short
	
	# History visualization
	glog = log --graph --decorate --oneline
	glog1 = log --pretty=format:\"%C(red)%h%Creset %C(cyan)<%an>%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset\" --abbrev-commit --graph
	glog2 = log --pretty='format:%C(yellow)%h %C(green)%cd %C(reset)%s %C(red)%d %C(cyan)[%an]' --date=iso
	glog3 = log --pretty=format:\"%C(red)%h%Creset %C(cyan)<%an>%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset\" --abbrev-commit --date=relative
	lgg= log --pretty=format:\"%C(red)%h%Creset %C(cyan)<%an>%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset\" --abbrev-commit --date=relative --graph
	lgg-all= log --pretty=format:\"%C(red)%h%Creset %C(cyan)<%an>%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset\" --abbrev-commit --date=relative --graph --branches
	lgv= log --pretty=format:\"%C(red)%h%Creset %C(cyan)<%an>%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset\" --abbrev-commit --date=relative
	
	# Basic diff tools
	diff-staged = diff --staged   # View staged changes
	dfs = diff --staged           # Shorthand for diff-staged
	dw = diff --color-words       # Word-level diff
	ls-changed = diff --name-only # List changed files
	
	# Repository info
	clone = clone --recursive     # Clone with submodules
	graph = log --graph -10 --branches --remotes --tags  --format=format:'%Cgreen%h %Creset %<(75,trunc)%s (%cN, %cr) %Cred%d' --date-order
	oneline = log --pretty=oneline
	
	# Workflow shortcuts
	pp=!git pull && git push      # Pull then push
	precommit = diff --cached --diff-algorithm=minimal -w
	
	# Safety features
	unstage = reset -q HEAD --    # Remove files from staging
	uncommit = reset --mixed HEAD~ # Undo last commit
	amend = commit --amend        # Fix last commit
	discard = checkout --         # Discard changes
	unmerged = diff --name-only --diff-filter=U
	add-detail = add -p          # Interactive staging
	
	# Information commands
	tags = tag                    # List tags
	branches = branch -a          # List branches
	stashes = stash list          # List stashes
	remotes = remote -v           # List remotes
	
	# Repository analysis
	ranking = shortlog -s -n --no-merges
	prjroot = rev-parse --show-toplevel
	dotgit = rev-parse --git-dir
	current-branch = !git branch | grep '*' | sed 's/* //'
	rm-merged-branch = !git branch --merged | grep -v '*' | xargs git branch -D
	
	# Commit management
	commit-modified-all = commit -a
	commit-fix = commit -a --amend
	cmm = commit -a
	cmf = commit -a --amend
	
	# Rebase helpers
	rebasing-commit = "!f='$(git rev-parse --git-dir)/rebase-apply/patch'; if [ -f '$f' ]; then git show $(head -n1 '$f'); else echo 'Heh?'; fi"

[push]
	default = simple

[pull]
	ff = only
	rebase = merges

[log]
	decorate = auto

[diff]
	colorMoved = default
	algorithm = histogram

[merge]
	conflictstyle = diff3
	ff = false

[delta]
    features = side-by-side line-numbers decorations
    syntax-theme = Dracula
    plus-style = syntax "#003800"
    minus-style = syntax "#3f0001"

[delta "decorations"]
    commit-decoration-style = bold yellow box ul
    file-style = bold yellow ul
    file-decoration-style = none
    hunk-header-decoration-style = cyan box ul

[delta "line-numbers"]
    line-numbers-left-style = cyan
    line-numbers-right-style = cyan
    line-numbers-minus-style = 124
    line-numbers-plus-style = 28

[user]
	email = dsisnero@gmail.com
	name = Dominic Sisneros

[interactive]
    diffFilter = delta --color-only --features=interactive
