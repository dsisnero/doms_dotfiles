#!/bin/bash

set -eu

## prepare
PWD=$(pwd)
# Use XDG_CONFIG_HOME if set, otherwise use home directory
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
WORK_DIR=~/work_dotfile

if [ ! -d ${WORK_DIR} ]; then
  mkdir -p ${WORK_DIR}
fi
cd ${WORK_DIR}

#if [ "$(uname)" == 'Darwin' ]; then
#  # nothing
#elif [ "$(expr substr $(uname -s) 1 5)" == 'Linux' ]; then
if [ "$(expr substr $(uname -s) 1 5)" == 'Linux' ]; then
  # if redhat
  if which yum >/dev/null 2>&1; then
    sudo yum install -y unzip
  fi
  # if ubuntu
  if which apt-get >/dev/null 2>&1; then
    sudo apt-get install -y unzip
  fi
  # if archlinux
  if which pacman >/dev/null 2>&1; then
    sudo pacman -S --noconfirm unzip
  fi
  
  # Install peco if missing
  if ! command -v peco &> /dev/null; then
    echo "Installing peco for Linux..."
    if which apt-get >/dev/null 2>&1; then
      sudo apt-get install -y peco
    elif which pacman >/dev/null 2>&1; then
      sudo pacman -S --noconfirm peco
    elif which yum >/dev/null 2>&1; then
      sudo yum install -y peco
    fi
  fi
  
  # Install neovim for diff tools
  if ! command -v nvim &> /dev/null; then
    echo "Installing neovim for diff tools..."
    if which apt-get >/dev/null 2>&1; then
      sudo apt-get install -y neovim
    elif which pacman >/dev/null 2>&1; then
      sudo pacman -S --noconfirm neovim
    elif which yum >/dev/null 2>&1; then
      sudo yum install -y neovim
    fi
  fi
elif [ "$(expr substr $(uname -s) 1 10)" == 'MINGW32_NT' ]; then
  echo "Installing Windows tools..."
  # Check if scoop is installed
  if ! command -v scoop &> /dev/null; then
    echo "Installing scoop package manager..."
    powershell -Command "Set-ExecutionPolicy RemoteSigned -Scope CurrentUser"
    powershell -Command "iex (new-object net.webclient).downloadstring('https://get.scoop.sh')"
  fi
  
  # Install Windows tools
  powershell -Command "scoop install fzf git"
  
  # Install VS Code if not present
  if ! command -v code &> /dev/null; then
    powershell -Command "scoop install vscode"
  fi
  
  # Ensure XDG_CONFIG_HOME is set for Windows
  if [ -z "$XDG_CONFIG_HOME" ]; then
    echo "export XDG_CONFIG_HOME=\"\$HOME/.config\"" >> "$HOME/.bashrc"
  fi
else
  echo "Your platform ($(uname -a)) is not supported."
  exit 1
fi

DOTFILEDIR=$WORK_DIR/dotfiles-main
if [ ! -d ${DOTFILEDIR} ]; then
  dotfile_github_url=https://github.com/dsisnero/doms_dotfiles/archive/main.zip
  curl -sOL $dotfile_github_url
  unzip main.zip
fi

cd $DOTFILEDIR

bin/setup
bin/deploy $@

## finish
cd $PWD
